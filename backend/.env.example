# ------------------------------------------------------------------------------
# 1. CORE INFRASTRUCTURE (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# Make sure your PostgreSQL server is running and the database exists.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/sih26183"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
POSTGRES_DB="sih26183"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="YOUR_DB_PASSWORD"

# Redis is required for WebSockets and Background Queues
REDIS_URL="redis://127.0.0.1:6379/0"
REDIS_QUEUE_NAME="tracex"
REDIS_EVENT_CHANNEL="tracex.events"
REDIS_JOB_VISIBILITY_TIMEOUT="300"

# ------------------------------------------------------------------------------
# 2. NEO4J GRAPH DATABASE (Topological Analytics)
# ------------------------------------------------------------------------------
# Set to 'false' if you want to bypass Neo4j syncing
NEO4J_ENABLED="true"
NEO4J_URI="bolt://127.0.0.1:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="YOUR_NEO4J_PASSWORD"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_NODES="10000"
NEO4J_MAX_RELATIONSHIPS="25000"

